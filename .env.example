# Optional deterministic demo backend. Demo mode needs no Telegram credentials
# or session and never contacts Telegram.
# TELEGRAM_MCP_DEMO=true

# Required Telegram application credentials for real Telegram mode and
# `auth login`. TELEGRAM_API_HASH is environment-only; never put a real value
# in a committed file.
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=replace-through-secret-store

# Select a Ferogram session explicitly, or leave this commented. `auth login`
# creates default.session in the resolved XDG data session directory when the
# cache is empty; normal MCP tools require exactly one candidate when no explicit
# path is configured. Default cache:
# $XDG_DATA_HOME/telegram-personal-mcp/sessions, then
# $HOME/.local/share/telegram-personal-mcp/sessions.
# TELEGRAM_MCP_SESSION_PATH=/absolute/path/to/account.session
# TELEGRAM_MCP_SESSION_CACHE_DIR=/absolute/path/to/private/sessions

# Optional environment-only SOCKS5 proxy. Do not commit credentials embedded in
# this URL.
# Shared MTProto and approval Bot API route. Bot API resolves its hostname
# through the SOCKS server even when this uses the socks5:// spelling.
# TELEGRAM_MCP_PROXY=socks5://127.0.0.1:2080

# Optional attachment cache override. Default:
# $XDG_CACHE_HOME/telegram-personal-mcp/attachments, then
# $HOME/.cache/telegram-personal-mcp/attachments.
# TELEGRAM_MCP_ATTACHMENT_CACHE_DIR=/absolute/path/to/attachments

# Download/upload limits default to 64 MiB each.
TELEGRAM_MCP_MAX_DOWNLOAD_BYTES=67108864
TELEGRAM_MCP_MAX_UPLOAD_BYTES=67108864

# Optional prepared-send ledger override. Default:
# $XDG_STATE_HOME/telegram-personal-mcp/state.sqlite, then
# $HOME/.local/state/telegram-personal-mcp/state.sqlite.
# TELEGRAM_MCP_STATE_DB=/absolute/path/to/state.sqlite

# Optional persistent message-cache override. Default: message-cache.sqlite
# beside TELEGRAM_MCP_STATE_DB (or beside the default state.sqlite).
# TELEGRAM_MCP_MESSAGE_CACHE_DB=/absolute/path/to/message-cache.sqlite

# Optional UTC age limit for cached message-history rows, in whole days.
# Allowed range: 1..=36500. Unset keeps message history until clear_cache.
# TELEGRAM_MCP_MESSAGE_CACHE_MAX_AGE_DAYS=30

# Optional singleton-daemon directory. Default resolution order:
# $XDG_RUNTIME_DIR/telegram-personal-mcp, then
# $XDG_STATE_HOME/telegram-personal-mcp/daemon, then
# $HOME/.local/state/telegram-personal-mcp/daemon, then a UID-scoped temporary
# directory. The directory is 0700; socket, lock, log, and the secret-free
# configuration identity are 0600. A live daemon is reused only when all
# effective settings match; otherwise stop it or choose another daemon dir.
# TELEGRAM_MCP_DAEMON_DIR=/absolute/path/to/private/daemon

# Optional permanent text-send approval surface. Set all three required values
# together. Use a dedicated private bot with no webhook or competing getUpdates
# consumer, and start that bot from the approving account first. Keep the token
# in a runtime secret store; this committed example contains no real value.
# TELEGRAM_MCP_APPROVAL_BOT_TOKEN=replace-through-secret-store
# TELEGRAM_MCP_APPROVAL_CHAT_ID=123456789
# TELEGRAM_MCP_APPROVAL_USER_ID=123456789
# TELEGRAM_MCP_APPROVAL_TTL_SECONDS=86400
# TELEGRAM_MCP_APPROVAL_POLL_SECONDS=5
# TELEGRAM_MCP_APPROVAL_API_BASE=https://api.telegram.org

# Optional stderr log filter.
# RUST_LOG=telegram_personal_mcp=debug,warn
